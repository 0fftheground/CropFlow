CROPFLOW_APP_NAME=CropFlow API
CROPFLOW_ENVIRONMENT=development
CROPFLOW_DEBUG=true
CROPFLOW_SQL_ECHO=false
CROPFLOW_REQUIRE_REAL_INTEGRATIONS=false
CROPFLOW_BACKGROUND_JOBS_ENABLED=false
CROPFLOW_SURVEY_RECOMMENDATION_INTERVAL_SECONDS=300
CROPFLOW_TASK_DUE_CHECK_INTERVAL_SECONDS=300
