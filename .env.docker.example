CROPFLOW_APP_NAME=CropFlow API
CROPFLOW_ENVIRONMENT=production
CROPFLOW_DEBUG=false
CROPFLOW_SQL_ECHO=false
CROPFLOW_REQUIRE_REAL_INTEGRATIONS=true

# Docker Compose database settings
CROPFLOW_POSTGRES_DB=cropflow_demo
CROPFLOW_POSTGRES_USER=cropflow
CROPFLOW_POSTGRES_PASSWORD=cropflow
CROPFLOW_POSTGRES_PORT=5432
CROPFLOW_DATABASE_URL=postgresql+psycopg://cropflow:cropflow@db:5432/cropflow_demo

# API exposure
CROPFLOW_API_PORT=8000

# Background jobs
CROPFLOW_BACKGROUND_JOBS_ENABLED=false
CROPFLOW_WEATHER_CHECK_INTERVAL_SECONDS=300
CROPFLOW_SURVEY_RECOMMENDATION_INTERVAL_SECONDS=300
CROPFLOW_TASK_DUE_CHECK_INTERVAL_SECONDS=300

# Container startup behavior
CROPFLOW_WAIT_FOR_DB_TIMEOUT_SECONDS=90
CROPFLOW_RUN_MIGRATIONS_ON_START=true
CROPFLOW_LOG_LEVEL=INFO

# Business Agent Runtime (required because real integrations are enabled).
CROPFLOW_AGENT_MODEL_PROVIDER=openai_compatible
CROPFLOW_AGENT_MODEL_BASE_URL=https://api.deepseek.com
CROPFLOW_AGENT_MODEL_API_KEY=replace-me
CROPFLOW_AGENT_MODEL_NAME=replace-with-provider-model-id
CROPFLOW_AGENT_MODEL_TIMEOUT_SECONDS=60
CROPFLOW_AGENT_MODEL_THINKING=enabled
CROPFLOW_AGENT_MODEL_REASONING_EFFORT=high
CROPFLOW_AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
CROPFLOW_AGENT_MODEL_MAX_ATTEMPTS=3
CROPFLOW_AGENT_MODEL_RETRY_BASE_DELAY_SECONDS=0.5
CROPFLOW_AGENT_MODEL_RETRY_MAX_DELAY_SECONDS=4
CROPFLOW_AGENT_MODEL_RETRY_JITTER_RATIO=0.2
CROPFLOW_AGENT_MODEL_RETRY_AFTER_MAX_SECONDS=10
CROPFLOW_AGENT_RUN_EXECUTION_TIMEOUT_SECONDS=180
CROPFLOW_AGENT_RUN_MAX_TOTAL_TOKENS=16000
# Cost budget is disabled until all four values below are explicitly set for the selected model.
# CROPFLOW_AGENT_RUN_MAX_ESTIMATED_COST_USD=0.01
# CROPFLOW_AGENT_MODEL_INPUT_CACHE_HIT_PRICE_PER_MILLION_USD=replace-with-current-price
# CROPFLOW_AGENT_MODEL_INPUT_CACHE_MISS_PRICE_PER_MILLION_USD=replace-with-current-price
# CROPFLOW_AGENT_MODEL_OUTPUT_PRICE_PER_MILLION_USD=replace-with-current-price
CROPFLOW_AGENT_DEFAULT_ROLE=observer
CROPFLOW_AGENT_MAX_ITERATIONS=8
CROPFLOW_AGENT_MAX_PARALLEL_QUERIES=4
CROPFLOW_AGENT_CONTEXT_TASK_LIMIT=20
CROPFLOW_AGENT_CONTEXT_REVIEW_LIMIT=20

CROPFLOW_WEED_DIAGNOSIS_BASE_URL=http://example.local
CROPFLOW_PEST_DISEASE_SURVEY_BASE_URL=http://example.local
# Optional. If omitted, pest disease control falls back to CROPFLOW_PEST_DISEASE_SURVEY_BASE_URL.
# CROPFLOW_PEST_DISEASE_CONTROL_BASE_URL=http://example.local
CROPFLOW_STAGE_PREDICTION_BASE_URL=http://example.local
CROPFLOW_WEATHER_API_BASE_URL=http://example.local
CROPFLOW_WEATHER_API_TOKEN=replace-me
# Optional alert endpoint.
# CROPFLOW_WEATHER_ALERT_API_BASE_URL=http://example.local
# CROPFLOW_WEATHER_ALERT_API_TOKEN=replace-me
