CROPFLOW_APP_NAME=CropFlow API
CROPFLOW_ENVIRONMENT=production
CROPFLOW_DEBUG=false
CROPFLOW_SQL_ECHO=false
CROPFLOW_REQUIRE_REAL_INTEGRATIONS=true

# Docker Compose database settings
CROPFLOW_POSTGRES_DB=cropflow_demo
CROPFLOW_POSTGRES_USER=cropflow
CROPFLOW_POSTGRES_PASSWORD=cropflow
CROPFLOW_POSTGRES_PORT=5432
CROPFLOW_DATABASE_URL=postgresql+psycopg://cropflow:cropflow@db:5432/cropflow_demo

# API exposure
CROPFLOW_API_PORT=8000

# Background jobs
CROPFLOW_BACKGROUND_JOBS_ENABLED=false
CROPFLOW_WEATHER_CHECK_INTERVAL_SECONDS=300
CROPFLOW_SURVEY_RECOMMENDATION_INTERVAL_SECONDS=300
CROPFLOW_TASK_DUE_CHECK_INTERVAL_SECONDS=300

# Container startup behavior
CROPFLOW_WAIT_FOR_DB_TIMEOUT_SECONDS=90
CROPFLOW_RUN_MIGRATIONS_ON_START=true
CROPFLOW_LOG_LEVEL=INFO

CROPFLOW_WEED_DIAGNOSIS_BASE_URL=http://example.local
CROPFLOW_PEST_DISEASE_SURVEY_BASE_URL=http://example.local
# Optional. If omitted, pest disease control falls back to CROPFLOW_PEST_DISEASE_SURVEY_BASE_URL.
# CROPFLOW_PEST_DISEASE_CONTROL_BASE_URL=http://example.local
CROPFLOW_STAGE_PREDICTION_BASE_URL=http://example.local
CROPFLOW_WEATHER_API_BASE_URL=http://example.local
CROPFLOW_WEATHER_API_TOKEN=replace-me
# Optional alert endpoint.
# CROPFLOW_WEATHER_ALERT_API_BASE_URL=http://example.local
# CROPFLOW_WEATHER_ALERT_API_TOKEN=replace-me
